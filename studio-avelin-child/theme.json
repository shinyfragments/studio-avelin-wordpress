{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1400px"
		},
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "color": "#F2F2F2", "name": "Off White" },
				{ "slug": "surface", "color": "#F8F8F8", "name": "Surface" },
				{ "slug": "contrast", "color": "#3D3D3D", "name": "Ink" },
				{ "slug": "contrast-soft", "color": "#2A2A27", "name": "Ink Soft" },
				{ "slug": "muted", "color": "#6B6F76", "name": "Muted" },
				{ "slug": "line", "color": "#DCDCDA", "name": "Line" },
				{ "slug": "accent", "color": "#C7F000", "name": "Lime" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Poppins",
					"fontFamily": "\"Poppins\", \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "body",
					"name": "Raleway",
					"fontFamily": "\"Raleway\", \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "medium", "size": "1rem", "name": "Medium" },
				{ "slug": "large", "size": "1.5rem", "name": "Large" },
				{ "slug": "x-large", "size": "2.5rem", "name": "Extra Large" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "textDecoration": "none" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--contrast-soft)" }
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "300",
					"letterSpacing": "-0.02em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "#FFFFFF"
				},
				"border": { "radius": "999px" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "0.85rem"
				}
			}
		}
	}
}
